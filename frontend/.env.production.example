NEXT_PUBLIC_SUPABASE_URL=https://dssyufxseilflgmttavt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The deployed FastAPI service's URL, e.g. https://<service>.up.railway.app
# (no trailing slash). See DEPLOYMENT.md for the Railway setup.
PYTHON_API_URL=

# Shared secret between this app and the FastAPI service — set the exact
# same value in both Vercel's and Railway's environment variables. Not in
# the original env var list; added because the FastAPI service holds the
# Supabase service role key and accepts a caller-supplied user_id on every
# endpoint, so it needs to reject requests that didn't come from this app.
INTERNAL_API_KEY=
