NEXT_PUBLIC_SUPABASE_URL=https://dssyufxseilflgmttavt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The FastAPI service (api/main.py) — run it locally with
# `uvicorn api.main:app --reload` from the repo root, which defaults to
# this URL.
PYTHON_API_URL=http://localhost:8000

# Shared secret between this app and the FastAPI service (see
# api/main.py's _require_internal_api_key) — set the same value on both
# sides. Not in the original env var list; added because the FastAPI
# service holds the Supabase service role key and accepts a caller-supplied
# user_id on every endpoint, so it needs to reject requests that didn't
# come from this app.
INTERNAL_API_KEY=
